/*
  手机端 Web 版样式
  与小程序版共用同一套设计变量与语义色；布局从 rpx 换成 rem/px，适配真机浏览器。
  safe-area 处理：底部 tabbar 与 sheet 都避开 iPhone 的 home indicator。
*/

:root {
  --bg: #f3f5fb;
  --card: #fff;
  --ink: #0f172a;
  --ink2: #5b6b85;
  --ink3: #97a3b8;
  --line: #e8edf7;
  --brand: #4f6ef7;
  --brand2: #7c5cff;
  --brand-soft: rgba(79, 110, 247, .1);
  --ok: #10b981;
  --ok-soft: rgba(16, 185, 129, .12);
  --warn: #f59e0b;
  --warn-soft: rgba(245, 158, 11, .12);
  --bad: #ef4444;
  --bad-soft: rgba(239, 68, 68, .12);
  --accent: #06b6d4;
  --accent-soft: rgba(6, 182, 212, .12);
  --safe-b: env(safe-area-inset-bottom, 0px);
  --safe-t: env(safe-area-inset-top, 0px);
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  overscroll-behavior-y: none;
}

body { min-height: 100vh; min-height: 100dvh; }

.shell {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  min-height: 100dvh;
  max-width: 560px;
  margin: 0 auto;
  background: var(--bg);
}

/* ---------- 顶部栏 ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: calc(var(--safe-t) + 10px) 12px 10px;
  background: rgba(243, 245, 251, .88);
  backdrop-filter: saturate(160%) blur(14px);
  -webkit-backdrop-filter: saturate(160%) blur(14px);
  border-bottom: 1px solid transparent;
  transition: border-color .2s;
}

.topbar.scrolled { border-bottom-color: var(--line); }

.tb-back {
  width: 34px;
  height: 34px;
  border: none;
  background: transparent;
  color: var(--ink2);
  font-size: 22px;
  line-height: 1;
  cursor: pointer;
  padding: 0;
  display: none;
  flex: 0 0 auto;
}

.tb-back.show { display: block; }
.tb-back::before { content: '‹'; }

.tb-title {
  flex: 1;
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  text-align: center;
  letter-spacing: .5px;
  color: var(--ink);
}

.tb-actions { flex: 0 0 auto; width: 34px; display: flex; justify-content: flex-end; }

.tb-btn {
  border: none;
  background: transparent;
  color: var(--ink3);
  font-size: 18px;
  letter-spacing: 2px;
  cursor: pointer;
  padding: 4px;
}

/* ---------- 内容区 ---------- */
.content {
  flex: 1;
  padding: 4px 10px calc(78px + var(--safe-b));
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ---------- 底部 tabbar ---------- */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  max-width: 560px;
  margin: 0 auto;
  height: calc(58px + var(--safe-b));
  padding-bottom: var(--safe-b);
  background: rgba(255, 255, 255, .94);
  backdrop-filter: saturate(160%) blur(14px);
  -webkit-backdrop-filter: saturate(160%) blur(14px);
  border-top: 1px solid var(--line);
  display: flex;
}

.tab {
  flex: 1;
  border: none;
  background: transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1px;
  color: var(--ink3);
  font-size: 11px;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
  transition: color .15s;
}

.tab .ti { font-size: 19px; line-height: 1; }
.tab .tl { font-size: 11px; }
.tab.active { color: var(--brand); }

/* ---------- 通用卡片 ---------- */
.page { padding-top: 4px; }

.card {
  background: var(--card);
  border-radius: 14px;
  padding: 15px;
  margin-bottom: 11px;
  box-shadow: 0 3px 12px rgba(15, 23, 42, .06);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 14.5px;
  font-weight: 600;
  margin-bottom: 9px;
}

.card-title .sub { font-size: 11px; color: var(--ink3); font-weight: 400; }

.section-label {
  font-size: 12px;
  color: var(--ink3);
  padding: 3px 3px 7px;
  font-weight: 500;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  font-size: 13.5px;
}

.row:last-child { border-bottom: none; }
.row .k { color: var(--ink2); }
.row .v { font-weight: 500; font-variant-numeric: tabular-nums; text-align: right; }
.row .v.dim { font-weight: 400; color: var(--ink3); }
.row.tappable { cursor: pointer; }
.row.tappable:active { opacity: .7; }

/* ---------- 标签 ---------- */
.tag {
  display: inline-block;
  padding: 3px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
}

.tag-ok { color: #05704e; background: var(--ok-soft); }
.tag-warn { color: #92600a; background: var(--warn-soft); }
.tag-bad { color: #a51b1b; background: var(--bad-soft); }
.tag-brand { color: var(--brand); background: var(--brand-soft); }
.tag-accent { color: #0a6b7d; background: var(--accent-soft); }
.tag-mute { color: var(--ink3); background: #f1f4fa; }

.mono { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 10.5px; color: #b6c0d4; word-break: break-all; }
.muted { color: var(--ink3); font-size: 12px; line-height: 1.7; }

.ok { color: var(--ok); }
.warn { color: var(--warn); }
.bad { color: var(--bad); }
.brand { color: var(--brand); }

/* ---------- 按钮 ---------- */
.btn {
  display: block;
  width: 100%;
  margin-top: 10px;
  padding: 12px;
  border-radius: 11px;
  border: none;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  transition: transform .1s, opacity .1s;
}

.btn:active { transform: scale(.985); opacity: .9; }
.btn-primary {
  background: linear-gradient(135deg, var(--brand), var(--brand2));
  color: #fff;
  box-shadow: 0 8px 22px rgba(79, 110, 247, .28);
  font-weight: 600;
}
.btn-danger { background: var(--bad-soft); color: var(--bad); }

.divider { height: 1px; background: var(--line); margin: 10px 0; }
.empty { text-align: center; padding: 44px 20px; color: var(--ink3); font-size: 13px; }

/* ================= 首页 ================= */
.hero { display: flex; align-items: flex-start; justify-content: space-between; padding: 12px 2px 0; }
.hero-date { font-size: 24px; font-weight: 700; letter-spacing: .5px; }
.hero-week { font-size: 12.5px; color: var(--ink3); margin-top: 3px; display: flex; align-items: center; gap: 6px; }

.rule-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #fff;
  border: none;
  border-radius: 999px;
  padding: 7px 12px 7px 10px;
  box-shadow: 0 2px 8px rgba(15, 23, 42, .07);
  margin-top: 2px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink);
  font-family: inherit;
}

.rule-chip:active { opacity: .8; }
.chip-dot { width: 7px; height: 7px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand2)); }
.chip-arrow { color: var(--ink3); font-size: 12px; }

.rule-line { font-size: 12px; color: var(--ink2); padding: 8px 3px 0; font-variant-numeric: tabular-nums; }

.punch-zone { position: relative; display: flex; flex-direction: column; align-items: center; padding: 24px 0 16px; }

.halo {
  position: absolute;
  top: 16px;
  width: 270px;
  height: 270px;
  border-radius: 50%;
  filter: blur(30px);
  opacity: .5;
  pointer-events: none;
  transition: background .3s;
}

.halo-in { background: radial-gradient(circle, rgba(79, 110, 247, .55), rgba(79, 110, 247, 0) 68%); }
.halo-out { background: radial-gradient(circle, rgba(124, 92, 255, .5), rgba(124, 92, 255, 0) 68%); }

.punch-btn {
  position: relative;
  z-index: 1;
  width: 210px;
  height: 210px;
  border-radius: 50%;
  border: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  cursor: pointer;
  font-family: inherit;
  transition: transform .12s cubic-bezier(.34, 1.4, .64, 1), box-shadow .2s;
}

.punch-btn:active { transform: scale(.94); }
.punch-btn.done { filter: grayscale(.15) brightness(.98); }

.btn-in {
  background: linear-gradient(150deg, #5b7cff, #4f6ef7 55%, #4459e6);
  box-shadow: 0 12px 32px rgba(79, 110, 247, .42), inset 0 -3px 12px rgba(0, 0, 0, .1), inset 0 3px 10px rgba(255, 255, 255, .24);
}

.btn-out {
  background: linear-gradient(150deg, #8f6dff, #7c5cff 55%, #6a4ae0);
  box-shadow: 0 12px 32px rgba(124, 92, 255, .42), inset 0 -3px 12px rgba(0, 0, 0, .1), inset 0 3px 10px rgba(255, 255, 255, .24);
}

.btn-time { font-size: 38px; font-weight: 700; font-variant-numeric: tabular-nums; letter-spacing: 1px; line-height: 1.05; text-shadow: 0 2px 8px rgba(0, 0, 0, .15); }
.btn-label { font-size: 15.5px; font-weight: 600; margin-top: 5px; letter-spacing: 1px; }
.btn-hint { font-size: 11px; opacity: .8; margin-top: 5px; }

.punch-caption { display: flex; align-items: center; gap: 7px; margin-top: 15px; z-index: 1; padding: 0 16px; text-align: center; flex-wrap: wrap; justify-content: center; }
.caption-text { font-size: 12px; color: var(--ink2); line-height: 1.5; }

.tl-card { padding: 18px 15px 14px; }
.tl { display: flex; align-items: flex-start; }
.tl-node { display: flex; align-items: flex-start; }
.tl-node.right { flex-direction: row-reverse; text-align: right; }
.tl-mark { width: 18px; height: 18px; border-radius: 50%; background: #f1f4fa; display: flex; align-items: center; justify-content: center; margin-top: 2px; border: 1.5px solid #e3eaf6; flex: 0 0 auto; }
.tl-mark.done { background: var(--brand-soft); border-color: var(--brand); }
.tl-dot { width: 6px; height: 6px; border-radius: 50%; background: #cbd5e1; }
.tl-mark.done .tl-dot { background: var(--brand); }
.tl-info { margin: 0 9px; }
.tl-what { font-size: 11px; color: var(--ink3); font-weight: 500; }
.tl-when { font-size: 21px; font-weight: 700; color: #b6c0d4; font-variant-numeric: tabular-nums; letter-spacing: .5px; line-height: 1.25; }
.tl-when.strong { color: var(--ink); }
.tl-plan { font-size: 9.5px; color: var(--ink3); }
.tl-line { flex: 1; height: 3px; background: #eef2fa; border-radius: 3px; margin-top: 9px; overflow: hidden; }
.tl-line-fill { height: 100%; background: linear-gradient(90deg, var(--brand), var(--brand2)); border-radius: 3px; transition: width .5s cubic-bezier(.4, 0, .2, 1); }

.metrics { display: flex; align-items: center; }
.metric { flex: 1; text-align: center; }
.m-val { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
.m-val.tone-ok { color: var(--ok); }
.m-val.tone-warn { color: var(--warn); }
.m-key { font-size: 10.5px; color: var(--ink3); margin-top: 2px; }
.m-sep { width: 1px; height: 24px; background: var(--line); }

.alerts { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
.alert { display: flex; align-items: center; gap: 5px; padding: 5px 10px; border-radius: 8px; font-size: 11px; font-weight: 500; }
.alert-dot { width: 5px; height: 5px; border-radius: 50%; flex: 0 0 auto; }
.alert-warn { background: var(--warn-soft); color: #92600a; }
.alert-warn .alert-dot { background: var(--warn); }
.alert-bad { background: var(--bad-soft); color: #a51b1b; }
.alert-bad .alert-dot { background: var(--bad); }
.alert-accent { background: var(--accent-soft); color: #0a6b7d; }
.alert-accent .alert-dot { background: var(--accent); }

.geo-card { padding: 14px 15px 13px; }
.geo-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.geo-name { font-size: 14.5px; font-weight: 600; }
.geo-sub { font-size: 11.5px; color: var(--ink3); margin-left: 6px; }
.geo-state { display: flex; align-items: center; gap: 5px; font-size: 12.5px; font-weight: 600; white-space: nowrap; }
.geo-state.ok { color: var(--ok); }
.geo-state.bad { color: var(--bad); }
.geo-dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
.geo-row { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 12.5px; }
.geo-row:last-child { border-bottom: none; }
.geo-k { color: var(--ink3); }
.geo-v { font-variant-numeric: tabular-nums; }
.geo-actions { display: flex; gap: 9px; margin-top: 10px; }
.geo-btn {
  flex: 1;
  height: 40px;
  font-size: 13.5px;
  border-radius: 9px;
  background: var(--brand-soft);
  color: var(--brand);
  border: none;
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
}
.geo-btn:active { opacity: .8; }

/* ================= 记录页 ================= */
.monthbar { display: flex; align-items: center; justify-content: space-between; padding: 12px 2px 9px; }
.mb-side {
  width: 38px;
  height: 38px;
  border: none;
  text-align: center;
  font-size: 20px;
  color: var(--ink2);
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 2px 7px rgba(15, 23, 42, .06);
  cursor: pointer;
  font-family: inherit;
  padding: 0;
}
.mb-side:active { opacity: .7; }
.mb-center { text-align: center; }
.mb-month { font-size: 17.5px; font-weight: 700; font-variant-numeric: tabular-nums; display: block; }
.mb-arrow { font-size: 11px; color: var(--brand); cursor: pointer; background: none; border: none; font-family: inherit; padding: 2px; }

.summary { padding: 14px 10px; }
.sum-row { display: flex; }
.sum-item { flex: 1; text-align: center; }
.sum-val { font-size: 21px; font-weight: 700; font-variant-numeric: tabular-nums; }
.sum-val.warn { color: var(--warn); }
.sum-val.accent { color: var(--accent); }
.sum-key { font-size: 10.5px; color: var(--ink3); margin-top: 2px; }

.chain { display: flex; align-items: center; gap: 9px; padding: 12px; border-radius: 11px; margin-bottom: 11px; cursor: pointer; border: none; width: 100%; text-align: left; font-family: inherit; }
.chain.ok { background: var(--ok-soft); }
.chain.bad { background: var(--bad-soft); }
.chain-icon { width: 23px; height: 23px; border-radius: 50%; text-align: center; line-height: 23px; font-size: 13px; font-weight: 700; color: #fff; flex: 0 0 auto; }
.chain.ok .chain-icon { background: var(--ok); }
.chain.bad .chain-icon { background: var(--bad); }
.chain-title { font-size: 13px; font-weight: 600; display: block; }
.chain.ok .chain-title { color: #05704e; }
.chain.bad .chain-title { color: #a51b1b; }
.chain-sub { font-size: 10.5px; color: var(--ink2); margin-top: 2px; display: block; word-break: break-all; }
.chain-text { flex: 1; min-width: 0; }
.chain-more { font-size: 11.5px; color: var(--ink2); white-space: nowrap; flex: 0 0 auto; }

.weekbar { display: flex; justify-content: space-between; background: #fff; border-radius: 11px; padding: 10px 5px; margin-bottom: 11px; box-shadow: 0 3px 10px rgba(15, 23, 42, .05); }
.wb-day { flex: 1; text-align: center; padding: 3px 0; border-radius: 6px; }
.wb-day.today { background: var(--brand-soft); }
.wb-w { font-size: 10px; color: var(--ink3); display: block; }
.wb-d { font-size: 14px; font-weight: 600; font-variant-numeric: tabular-nums; display: block; margin-top: 1px; }
.wb-day.today .wb-d { color: var(--brand); }
.wb-dot { width: 4px; height: 4px; border-radius: 50%; display: block; margin: 2px auto 0; }
.wb-ok { background: var(--ok); }
.wb-warn { background: var(--warn); }
.wb-bad { background: var(--bad); }
.wb-mute { background: #d5dceb; }

.day { background: #fff; border-radius: 11px; padding: 12px; margin-bottom: 8px; box-shadow: 0 2px 8px rgba(15, 23, 42, .05); }
.day-main { display: flex; align-items: center; justify-content: space-between; cursor: pointer; gap: 8px; }
.day-left { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; flex: 1; min-width: 0; }
.day-date { display: flex; align-items: baseline; gap: 4px; flex: 0 0 auto; }
.dd-num { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; }
.dd-week { font-size: 11px; color: var(--ink3); }
.day-tags { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
.day-right { text-align: right; flex: 0 0 auto; }
.day-times { font-size: 13.5px; font-variant-numeric: tabular-nums; font-weight: 500; }
.dash { color: var(--ink3); margin: 0 3px; }
.day-work { font-size: 11px; color: var(--ink3); margin-top: 1px; }

.day-detail { margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line); }
.dt-row { display: flex; align-items: center; padding: 8px 0; border-bottom: 1px dashed var(--line); }
.dt-row:last-of-type { border-bottom: none; }
.dt-type { font-size: 11px; padding: 2px 8px; border-radius: 5px; background: var(--brand-soft); color: var(--brand); font-weight: 600; flex: 0 0 auto; }
.dt-type.out { background: rgba(124, 92, 255, .12); color: var(--brand2); }
.dt-mid { flex: 1; margin-left: 9px; min-width: 0; }
.dt-time { font-size: 13.5px; font-variant-numeric: tabular-nums; font-weight: 600; }
.dt-meta { font-size: 10.5px; color: var(--ink3); margin-top: 1px; }
.dt-hash { font-family: ui-monospace, Menlo, monospace; font-size: 9.5px; color: #b6c0d4; flex: 0 0 auto; }
.dt-actions { display: flex; justify-content: flex-end; gap: 16px; padding-top: 8px; }
.dt-link { font-size: 12px; color: var(--brand); font-weight: 500; cursor: pointer; background: none; border: none; font-family: inherit; padding: 4px; }

/* ================= 规则页 ================= */
.current { background: linear-gradient(135deg, #5b7cff, #7c5cff); color: #fff; box-shadow: 0 8px 22px rgba(79, 110, 247, .32); padding: 17px 15px; }
.cur-top { display: flex; align-items: center; gap: 8px; }
.cur-badge { font-size: 11px; background: rgba(255, 255, 255, .22); padding: 3px 9px; border-radius: 999px; font-weight: 600; }
.cur-name { font-size: 14.5px; font-weight: 600; opacity: .94; }
.cur-desc { font-size: 12.5px; margin-top: 8px; opacity: .88; font-variant-numeric: tabular-nums; }

.options { display: flex; flex-direction: column; gap: 9px; margin-bottom: 14px; }
.option {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 12px;
  padding: 14px 13px;
  border: 1.5px solid transparent;
  box-shadow: 0 3px 11px rgba(15, 23, 42, .05);
  cursor: pointer;
  transition: all .18s ease;
  text-align: left;
  font-family: inherit;
  width: 100%;
}
.option.active { border-color: var(--brand); box-shadow: 0 5px 16px rgba(79, 110, 247, .16); background: linear-gradient(180deg, rgba(79, 110, 247, .04), #fff 40%); }
.opt-radio { width: 19px; height: 19px; border-radius: 50%; border: 1.5px solid #ccd6e8; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; margin-top: 1px; margin-right: 10px; }
.option.active .opt-radio { border-color: var(--brand); }
.opt-radio-fill { width: 11px; height: 11px; border-radius: 50%; background: linear-gradient(135deg, var(--brand), var(--brand2)); }
.opt-body { flex: 1; min-width: 0; }
.opt-head { display: flex; align-items: center; gap: 7px; }
.opt-name { font-size: 15.5px; font-weight: 600; }
.opt-tag { font-size: 10.5px; color: var(--brand); background: var(--brand-soft); padding: 2px 7px; border-radius: 999px; font-weight: 600; white-space: nowrap; }
.opt-desc { font-size: 12.5px; color: var(--ink2); margin-top: 4px; }
.opt-detail { font-size: 11px; color: var(--ink3); margin-top: 3px; line-height: 1.6; }

/* ================= 统计页 ================= */
.hero-card {
  background: linear-gradient(135deg, #5b7cff, #7c5cff);
  border-radius: 14px;
  padding: 18px 16px;
  display: flex;
  align-items: center;
  color: #fff;
  box-shadow: 0 8px 22px rgba(79, 110, 247, .32);
  margin-bottom: 11px;
  gap: 12px;
}
.hero-main { flex: 1; min-width: 0; }
.hero-num { font-size: 44px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.05; letter-spacing: -.5px; }
.hero-unit { font-size: 18px; font-weight: 600; margin-left: 2px; opacity: .9; }
.hero-label { font-size: 11.5px; opacity: .85; margin-top: 3px; }
.hero-side { flex: 0 0 auto; padding-left: 14px; border-left: 1px solid rgba(255, 255, 255, .22); }
.hs-row { display: flex; align-items: center; justify-content: space-between; font-size: 11.5px; margin: 3px 0; min-width: 118px; }
.hs-k { opacity: .8; }
.hs-v { font-weight: 600; font-variant-numeric: tabular-nums; margin-left: 8px; }
.hs-v.warn { color: #ffe9b8; }

.grid-hd { display: flex; padding-bottom: 5px; }
.gh { flex: 1; text-align: center; font-size: 10.5px; color: var(--ink3); }
.grid { display: flex; flex-wrap: wrap; }
.cell { width: 14.2857%; aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 7px; margin: 1.5px 0; }
.cell-d { font-size: 13px; font-variant-numeric: tabular-nums; color: var(--ink3); font-weight: 500; }
.cell-dot { width: 5px; height: 5px; border-radius: 50%; margin-top: 2px; }
.cell.ok { background: rgba(16, 185, 129, .07); }
.cell.ok .cell-d { color: #05704e; }
.cell.ok .cell-dot { background: var(--ok); }
.cell.warn { background: rgba(245, 158, 11, .1); }
.cell.warn .cell-d { color: #92600a; }
.cell.warn .cell-dot { background: var(--warn); }
.cell.bad { background: rgba(239, 68, 68, .1); }
.cell.bad .cell-d { color: #a51b1b; }
.cell.bad .cell-dot { background: var(--bad); }
.cell.rest .cell-d { color: #c3cbdb; }
.cell.accent { background: rgba(6, 182, 212, .08); }
.cell.accent .cell-dot { background: var(--accent); }
.cell.today { box-shadow: inset 0 0 0 1.5px var(--brand); }
.cell.future { opacity: .32; }

.legend { display: flex; gap: 12px; margin-top: 9px; flex-wrap: wrap; font-size: 10.5px; color: var(--ink3); }
.legend span { display: flex; align-items: center; }
.legend i { width: 6px; height: 6px; border-radius: 50%; margin-right: 4px; display: inline-block; }

.dist { margin-bottom: 9px; }
.dist:last-child { margin-bottom: 0; }
.dist-left { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 4px; }
.dist-label { font-size: 12px; color: var(--ink2); }
.dist-count { font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
.dist-track { height: 6px; background: #f1f4fa; border-radius: 6px; overflow: hidden; }
.dist-fill { height: 100%; border-radius: 6px; transition: width .4s ease; }
.dist-ok { background: linear-gradient(90deg, #34d399, var(--ok)); }
.dist-warn { background: linear-gradient(90deg, #fbbf24, var(--warn)); }
.dist-bad { background: linear-gradient(90deg, #f87171, var(--bad)); }
.dist-accent { background: linear-gradient(90deg, #22d3ee, var(--accent)); }
.dist-mute { background: #d5dceb; }

.kpi { display: flex; }
.kpi-item { flex: 1; text-align: center; }
.kpi-val { font-size: 21px; font-weight: 700; font-variant-numeric: tabular-nums; }
.kpi-val.accent { color: var(--accent); }
.kpi-key { font-size: 10.5px; color: var(--ink3); margin-top: 2px; }

.bars { display: flex; justify-content: space-between; align-items: flex-end; height: 140px; padding-top: 5px; }
.bar-wrap { width: 12%; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; text-align: center; }
.bar-track { height: 90px; width: 16px; background: #f1f4fa; border-radius: 5px; margin: 0 auto; display: flex; align-items: flex-end; overflow: hidden; }
.bar-fill { width: 100%; border-radius: 5px 5px 0 0; min-height: 2px; }
.bar-ok { background: linear-gradient(180deg, #5b7cff, var(--brand)); }
.bar-warn { background: linear-gradient(180deg, #fbbf24, var(--warn)); }
.bar-bad { background: linear-gradient(180deg, #fca5a5, var(--bad)); }
.bar-mute { background: #dde4f0; }
.bar-v { font-size: 10.5px; color: var(--ink2); margin-top: 4px; font-variant-numeric: tabular-nums; }
.bar-l { font-size: 10px; color: var(--ink3); }

/* ================= 我的 ================= */
.profile {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #5b7cff, #7c5cff);
  border-radius: 14px;
  padding: 17px 15px;
  color: #fff;
  box-shadow: 0 8px 22px rgba(79, 110, 247, .32);
  margin-bottom: 13px;
  gap: 11px;
}
.avatar { width: 50px; height: 50px; border-radius: 14px; background: rgba(255, 255, 255, .22); display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700; flex: 0 0 auto; }
.pf-info { flex: 1; min-width: 0; }
.pf-name { font-size: 16.5px; font-weight: 600; }
.pf-meta { font-size: 11.5px; opacity: .85; margin-top: 3px; }
.pf-edit { font-size: 11.5px; padding: 5px 11px; border-radius: 999px; background: rgba(255, 255, 255, .2); cursor: pointer; border: none; color: #fff; font-family: inherit; }

.menu { background: #fff; border-radius: 12px; overflow: hidden; margin-bottom: 11px; box-shadow: 0 3px 11px rgba(15, 23, 42, .05); }
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 13px;
  border-bottom: 1px solid var(--line);
  cursor: pointer;
  border: none;
  width: 100%;
  background: none;
  text-align: left;
  font-family: inherit;
}
.menu-item:last-child { border-bottom: none; }
.menu-item:active { background: #fafbfe; }
.mi-left { flex: 1; min-width: 0; }
.mi-title { font-size: 14.5px; font-weight: 600; color: var(--ink); }
.mi-title.bad { color: var(--bad); }
.mi-desc { font-size: 11px; color: var(--ink3); margin-top: 2px; }
.mi-right { display: flex; align-items: center; gap: 7px; flex: 0 0 auto; }
.mi-badge { font-size: 11px; color: var(--brand); background: var(--brand-soft); padding: 2px 8px; border-radius: 999px; font-weight: 600; white-space: nowrap; }
.mi-arrow { font-size: 14px; color: var(--ink3); }

.about { text-align: center; padding: 10px 10px 0; }
.about-line { font-size: 10.5px; color: var(--ink3); line-height: 1.95; }

/* ================= toast / sheet ================= */
.toast {
  position: fixed;
  left: 50%;
  bottom: calc(110px + var(--safe-b));
  transform: translateX(-50%) translateY(8px);
  background: rgba(15, 23, 42, .94);
  color: #fff;
  font-size: 13px;
  padding: 10px 16px;
  border-radius: 11px;
  max-width: 82vw;
  text-align: center;
  line-height: 1.5;
  opacity: 0;
  transition: opacity .2s ease, transform .2s ease;
  pointer-events: none;
  z-index: 40;
}

.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, .42);
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s;
  z-index: 30;
}

.sheet-mask.show { opacity: 1; pointer-events: auto; }

.sheet {
  position: fixed;
  left: 50%;
  bottom: 0;
  width: 100%;
  max-width: 560px;
  transform: translateX(-50%) translateY(100%);
  transition: transform .26s cubic-bezier(.32, .72, 0, 1);
  z-index: 31;
  padding: 0 10px calc(10px + var(--safe-b));
}

.sheet.show { transform: translateX(-50%) translateY(0); }

.sheet-shell {
  background: #fff;
  border-radius: 18px;
  padding: 18px 16px 14px;
  box-shadow: 0 -8px 40px rgba(15, 23, 42, .18);
}

.sheet-title { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
.sheet-body { font-size: 13.5px; color: var(--ink2); line-height: 1.65; margin-bottom: 14px; white-space: pre-wrap; }
.sheet-input {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 11px 12px;
  font-size: 15px;
  font-family: inherit;
  color: var(--ink);
  background: #fafbfe;
  margin-bottom: 14px;
  outline: none;
}
.sheet-input:focus { border-color: var(--brand); background: #fff; }
.sheet-actions { display: flex; gap: 10px; }
.sheet-actions .btn { margin-top: 0; }

.sheet-btn-ghost { background: #f3f5fb; color: var(--ink2); font-weight: 500; }

/* ---------- 小屏适配 ---------- */
@media (max-height: 680px) {
  .punch-btn { width: 185px; height: 185px; }
  .btn-time { font-size: 33px; }
  .punch-zone { padding: 16px 0 12px; }
  .hero-num { font-size: 38px; }
}

@media (prefers-reduced-motion: reduce) {
  * { transition-duration: .01ms !important; animation-duration: .01ms !important; }
}
