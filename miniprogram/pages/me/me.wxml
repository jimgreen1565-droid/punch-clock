<view class="page">
  <!-- 身份卡 -->
  <view class="profile">
    <view class="avatar">{{initial}}</view>
    <view class="pf-info">
      <view class="pf-name">{{nickname || '未设置昵称'}}</view>
      <view class="pf-meta">{{ruleTypeName}} · {{envText}}</view>
    </view>
    <view class="pf-edit" bindtap="editNickname">编辑</view>
  </view>

  <!-- 今日概览 -->
  <view class="card today">
    <view class="card-title">
      <text>今日</text>
      <text class="sub">{{todayText}}</text>
    </view>
    <view class="row">
      <text class="k">状态</text>
      <text class="v"><text class="tag tag-{{todayTone}}">{{todayLabel}}</text></text>
    </view>
    <view class="row" wx:if="{{inText}}">
      <text class="k">上班</text>
      <text class="v">{{inText}}</text>
    </view>
    <view class="row" wx:if="{{outText}}">
      <text class="k">下班</text>
      <text class="v">{{outText}}</text>
    </view>
    <view class="row">
      <text class="k">今日工时</text>
      <text class="v">{{workText}}</text>
    </view>
  </view>

  <!-- 规则入口 -->
  <view class="section-label">考勤规则</view>
  <view class="menu">
    <view class="menu-item" bindtap="goRules">
      <view class="mi-left">
        <view class="mi-title">考勤规则</view>
        <view class="mi-desc">{{ruleDesc}}</view>
      </view>
      <view class="mi-right">
        <text class="mi-badge">{{ruleTypeName}}</text>
        <text class="mi-arrow">›</text>
      </view>
    </view>

    <view class="menu-item" bindtap="goStats">
      <view class="mi-left">
        <view class="mi-title">考勤统计</view>
        <view class="mi-desc">出勤率、工时、异常分布</view>
      </view>
      <text class="mi-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goAdmin">
      <view class="mi-left">
        <view class="mi-title">审批与异常</view>
        <view class="mi-desc">补卡审批、异常打卡审核</view>
      </view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 数据 -->
  <view class="section-label">数据</view>
  <view class="menu">
    <view class="menu-item">
      <view class="mi-left">
        <view class="mi-title">本地记录</view>
        <view class="mi-desc">{{recordCount}} 条 · 哈希链{{chainOk ? '完整' : '异常'}}</view>
      </view>
      <text class="tag tag-{{chainOk ? 'ok' : 'bad'}}">{{chainOk ? '校验通过' : '校验失败'}}</text>
    </view>

    <view class="menu-item" bindtap="exportData">
      <view class="mi-left">
        <view class="mi-title">导出数据</view>
        <view class="mi-desc">JSON 备份，复制到剪贴板</view>
      </view>
      <text class="mi-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="resetAll">
      <view class="mi-left">
        <view class="mi-title bad">清空全部数据</view>
        <view class="mi-desc">删除记录与规则，不可恢复</view>
      </view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <!-- 关于 -->
  <view class="about">
    <view class="about-line">打卡 v2 · 纯本地运行，数据不出手机</view>
    <view class="about-line">参考钉钉考勤模型：固定班制 / 弹性工作制 / 排班制 / 自由工时</view>
  </view>
</view>
