/* ============ 规则选择页 ============ */

.page {
  padding: 8rpx 28rpx 90rpx;
}

/* 当前规则摘要 */
.current {
  background: linear-gradient(135deg, #5b7cff, #7c5cff);
  color: #fff;
  box-shadow: 0 16rpx 44rpx rgba(79, 110, 247, 0.32);
  padding: 32rpx 30rpx;
}

.cur-top {
  display: flex;
  align-items: center;
}

.cur-badge {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.cur-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-left: 14rpx;
  opacity: 0.94;
}

.cur-desc {
  font-size: 24rpx;
  margin-top: 14rpx;
  opacity: 0.88;
  font-variant-numeric: tabular-nums;
}

/* 选项卡 */
.options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 26rpx;
}

.option {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 6rpx 22rpx rgba(15, 23, 42, 0.05);
  transition: all 0.18s ease;
}

.option.active {
  border-color: var(--brand);
  box-shadow: 0 10rpx 30rpx rgba(79, 110, 247, 0.16);
  background: linear-gradient(180deg, rgba(79, 110, 247, 0.04), #fff 40%);
}

.opt-radio {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #ccd6e8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  margin-top: 4rpx;
  margin-right: 18rpx;
  box-sizing: border-box;
}

.option.active .opt-radio {
  border-color: var(--brand);
}

.opt-radio-fill {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
}

.opt-body {
  flex: 1;
}

.opt-head {
  display: flex;
  align-items: center;
}

.opt-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.opt-tag {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-soft);
  padding: 3rpx 12rpx;
  border-radius: 999rpx;
  margin-left: 12rpx;
  font-weight: 600;
}

.opt-desc {
  font-size: 24rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
}

.opt-detail {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 6rpx;
  line-height: 1.6;
}

/* 提示 */
.hint {
  padding: 14rpx 0 2rpx;
  font-size: 21rpx;
}

/* 模板 */
.preset {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.preset:last-child {
  border-bottom: none;
}

.preset-main {
  flex: 1;
}

.preset-name {
  font-size: 27rpx;
  font-weight: 600;
}

.preset-desc {
  font-size: 21rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}

.preset-del {
  font-size: 22rpx;
  color: var(--bad);
  padding: 8rpx 12rpx;
}
