/* ============================================================
   全局样式 · 浅色 Aurora 主题
   设计取舍：
   - 打卡类应用一天要开很多次，深色在户外（强光）下看不清，所以主体用浅色
   - 只用一个主渐变（靛蓝→紫），辅助色按「语义」分配（正常=绿 / 异常=琥珀 / 严重=红）
   - 圆角统一 20rpx / 卡片阴影极浅（0 6rpx 24rpx rgba(15,23,42,.06)），避免页面发灰
   - 所有数字用 tabular-nums，时间对齐不跳动
   ============================================================ */

page {
  --bg: #f3f5fb;
  --bg-2: #eef1f9;
  --card: #ffffff;
  --ink: #0f172a;
  --ink-2: #5b6b85;
  --ink-3: #97a3b8;
  --line: #e8edf7;
  --line-2: #dbe4f3;
  --brand: #4f6ef7;
  --brand-2: #7c5cff;
  --brand-soft: rgba(79, 110, 247, 0.1);
  --ok: #10b981;
  --ok-soft: rgba(16, 185, 129, 0.12);
  --warn: #f59e0b;
  --warn-soft: rgba(245, 158, 11, 0.12);
  --bad: #ef4444;
  --bad-soft: rgba(239, 68, 68, 0.12);
  --accent: #06b6d4;
  --accent-soft: rgba(6, 182, 212, 0.12);

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 布局 ---------- */

.container {
  padding: 8rpx 28rpx 80rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.06);
}

.card-flat {
  background: var(--card);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 22rpx;
  border: 1rpx solid var(--line);
}

.card-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
  letter-spacing: 0.5rpx;
}

.card-title .sub {
  font-size: 22rpx;
  color: var(--ink-3);
  font-weight: 400;
}

.section-label {
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 6rpx 6rpx 14rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* ---------- 行 / 列表 ---------- */

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.row:last-child {
  border-bottom: none;
}

.row .k {
  color: var(--ink-2);
  font-size: 26rpx;
}

.row .v {
  font-size: 27rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  text-align: right;
}

.row .v.dim {
  font-weight: 400;
  color: var(--ink-3);
}

/* ---------- 标签 ---------- */

.tag {
  display: inline-block;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 600;
}

.tag-ok {
  color: #05704e;
  background: var(--ok-soft);
}

.tag-warn {
  color: #92600a;
  background: var(--warn-soft);
}

.tag-bad {
  color: #a51b1b;
  background: var(--bad-soft);
}

.tag-brand {
  color: var(--brand);
  background: var(--brand-soft);
}

.tag-accent {
  color: #0a6b7d;
  background: var(--accent-soft);
}

.tag-mute {
  color: var(--ink-3);
  background: #f1f4fa;
}

/* ---------- 文字 ---------- */

.mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 22rpx;
  color: var(--ink-3);
  word-break: break-all;
  letter-spacing: 0.5rpx;
}

.muted {
  color: var(--ink-3);
  font-size: 23rpx;
  line-height: 1.7;
}

.ok {
  color: var(--ok);
}

.warn {
  color: var(--warn);
}

.bad {
  color: var(--bad);
}

.brand {
  color: var(--brand);
}

/* ---------- 按钮 ---------- */

.btn-primary {
  background: linear-gradient(135deg, var(--brand), var(--brand-2));
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  box-shadow: 0 10rpx 26rpx rgba(79, 110, 247, 0.28);
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: var(--brand-soft);
  color: var(--brand);
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 500;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border: none;
}

.btn-ghost::after {
  border: none;
}

.btn-outline {
  background: transparent;
  color: var(--ink-2);
  border-radius: 18rpx;
  font-size: 27rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border: 1rpx solid var(--line-2);
}

.btn-outline::after {
  border: none;
}

.btn-danger {
  background: var(--bad-soft);
  color: var(--bad);
  border-radius: 18rpx;
  font-size: 27rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border: none;
  margin-top: 16rpx;
}

.btn-danger::after {
  border: none;
}

/* ---------- 底部说明 ---------- */

.footer-note {
  text-align: center;
  color: var(--ink-3);
  font-size: 22rpx;
  margin-top: 32rpx;
  line-height: 1.8;
  padding: 0 40rpx;
}

/* ---------- 空态 ---------- */

.empty {
  text-align: center;
  padding: 80rpx 40rpx;
  color: var(--ink-3);
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  display: block;
  margin-bottom: 16rpx;
  opacity: 0.4;
}

/* ---------- 分割 ---------- */

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}
